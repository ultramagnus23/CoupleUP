# PostgreSQL connection string (Neon / Supabase / Railway recommended)
DATABASE_URL="postgresql://user:password@localhost:5432/coupleup"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"   # generate: openssl rand -base64 32

# Instagram OAuth (Meta Developer Console — optional if using Google only)
INSTAGRAM_CLIENT_ID="your-instagram-client-id"
INSTAGRAM_CLIENT_SECRET="your-instagram-client-secret"

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Vercel Blob — for mandatory photo uploads (Google users)
# Get this from: Vercel dashboard → your project → Storage → Blob → Connect Store
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"

# Terms & Conditions version (increment when you update T&C to re-prompt users)
TC_VERSION="1.0"
